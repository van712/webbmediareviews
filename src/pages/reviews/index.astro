---
import ReviewsListing from "../../components/ReviewsListing.astro";
import { REVIEWS, REVIEW_COUNT, ALL_FIVE_STAR } from "../../data/reviews";
import { CASE_STUDIES } from "../../data/case-studies";

const withReviews = CASE_STUDIES.filter((c) => c.reviewId);
---

<ReviewsListing
    title={`All Webb Media Reviews (${REVIEW_COUNT}${ALL_FIVE_STAR ? " × 5-Star" : ""} Google Reviews)`}
    description={`Every Webb Media client review from Google in one place: ${REVIEW_COUNT}${ALL_FIVE_STAR ? " five-star" : ""} reviews from tradies and business owners about Van Topham's Facebook ads, websites and coaching.`}
    h1="Every Webb Media review, in one place"
    lead="Every client review from Webb Media's Google profile, unedited, with Webb Media's replies. Filter by service, or click through to see the results behind a review."
    crumbs={[{ name: "Reviews", path: "/reviews/" }]}
    reviews={REVIEWS}
    cases={withReviews}
    casesTitle="The results behind these reviews"
/>
