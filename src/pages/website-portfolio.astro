---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { CASE_STUDIES, OTHER_BUILDS } from "../data/case-studies";
import { reviewById, reviewsFor } from "../data/reviews";
import { breadcrumbLd } from "../lib/schema";
import { sizeOf } from "../lib/images";

const crumbs = [{ name: "Website portfolio", path: "/website-portfolio/" }];

const host = (url: string) => new URL(url).hostname.replace(/^www\./, "");

const sites = [
    ...CASE_STUDIES.filter((c) => c.service === "websites").map((c) => ({
        company: c.company,
        industry: c.industry,
        note: c.headline,
        url: c.siteUrl,
        image: c.siteImage,
        caseStudy: `/case-studies/${c.slug}/`,
        review: c.reviewId ? reviewById(c.reviewId) : undefined,
        quote: c.emails?.[0],
    })),
    ...OTHER_BUILDS.map((b) => ({
        company: b.company,
        industry: undefined,
        note: b.note,
        url: b.url,
        image: b.image,
        caseStudy: undefined,
        review: b.reviewId ? reviewById(b.reviewId) : undefined,
        quote: b.quote ? { ...b.quote, subject: "" } : undefined,
    })),
];
const websiteReviewCount = reviewsFor("websites").length;
---

<Base
    title="Webb Media Website Portfolio | Websites Built for Tradies"
    description={`${sites.length} websites designed and built by Webb Media for Australian trade businesses, with live links, results and ${websiteReviewCount} client reviews of the work.`}
    schema={[breadcrumbLd(crumbs)]}
>
    <PageHero
        eyebrow="Website portfolio"
        title="Websites built by Webb Media"
        lead="Every site here is live, so you can click through and judge the work yourself. Where there are results or a review from the owner, they're shown with it."
        crumbs={crumbs}
    >
        <div class="btn-row hero-links">
            <a class="btn btn-ghost" href="/reviews/website-design/">Website design reviews</a>
        </div>
    </PageHero>

    <section class="section">
        <div class="wrap grid grid-3">
            {
                sites.map((site) => (
                    <article class="card site">
                        {site.image ? (
                            <a href={site.url} target="_blank" rel="noopener" class="shot-link">
                                <img src={site.image} alt={`${site.company} website designed by Webb Media`} loading="lazy" {...sizeOf(site.image)} />
                            </a>
                        ) : (
                            site.url && (
                                <a href={site.url} target="_blank" rel="noopener" class="shot-link ph">
                                    <span>{host(site.url)}</span>
                                </a>
                            )
                        )}
                        <div class="body">
                            {site.industry && <span class="chip">{site.industry}</span>}
                            <h2>{site.company}</h2>
                            <p class="muted">{site.note}</p>
                            {site.review && (
                                <blockquote>
                                    “{site.review.text.length > 160 ? site.review.text.slice(0, site.review.text.lastIndexOf(" ", 160)) + "…" : site.review.text}”
                                    <cite>
                                        <a href={`/reviews/#${site.review.id}`}>{site.review.name}, Google review</a>
                                    </cite>
                                </blockquote>
                            )}
                            {!site.review && site.quote && (
                                <blockquote>
                                    “{site.quote.text}”<cite>{site.quote.author}, by email</cite>
                                </blockquote>
                            )}
                            <div class="links">
                                {site.url && (
                                    <a href={site.url} target="_blank" rel="noopener">
                                        Visit {host(site.url)} ↗
                                    </a>
                                )}
                                {site.caseStudy && <a href={site.caseStudy}>Case study →</a>}
                            </div>
                        </div>
                    </article>
                ))
            }
        </div>
    </section>

    <CtaBand />
</Base>

<style>
    .hero-links {
        margin-top: 20px;
    }
    .site {
        padding: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .shot-link img {
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        object-position: top;
        border-bottom: 1px solid var(--border);
    }
    .ph {
        display: grid;
        place-items: center;
        aspect-ratio: 16 / 10;
        background: radial-gradient(80% 80% at 50% 0%, rgb(221 40 40 / 0.18), transparent 70%), var(--surface-2);
        border-bottom: 1px solid var(--border);
        text-decoration: none;
        font-weight: 700;
        color: var(--muted);
    }
    .body {
        padding: 20px 22px 24px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex: 1;
    }
    .body h2 {
        font-size: 1.3rem;
        margin: 0;
    }
    .body p {
        margin: 0;
    }
    blockquote {
        margin: 4px 0 0;
        padding-left: 12px;
        border-left: 3px solid var(--red);
        font-size: 0.92rem;
        color: #e4e4e7;
    }
    cite {
        display: block;
        font-style: normal;
        font-size: 0.8rem;
        margin-top: 4px;
        color: var(--subtle);
    }
    cite a {
        color: var(--subtle);
    }
    .links {
        margin-top: auto;
        padding-top: 8px;
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        font-weight: 600;
        font-size: 0.92rem;
    }
    .links a {
        color: #fca5a5;
        text-decoration: none;
    }
    .chip {
        align-self: flex-start;
    }
</style>
