---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, BUSINESS, SOCIALS } from "../data/site";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    noindex?: boolean;
    /** Extra JSON-LD objects for this page (breadcrumbs, FAQ, etc). */
    schema?: Record<string, unknown>[];
}

const { title = SITE.defaultTitle, description = SITE.defaultDescription, image = SITE.ogImage, noindex = false, schema = [] } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

// Same entity as the main site (same @id), so Google ties both domains to one Webb Media.
const organization = {
    "@context": "https://schema.org",
    "@type": ["Organization", "ProfessionalService"],
    "@id": BUSINESS.orgId,
    name: BUSINESS.name,
    url: BUSINESS.mainSite,
    logo: BUSINESS.logo,
    telephone: "+61491714686",
    email: BUSINESS.email,
    taxID: BUSINESS.abn.replace(/\s/g, ""),
    founder: { "@type": "Person", "@id": BUSINESS.personId, name: BUSINESS.founder },
    areaServed: { "@type": "Country", name: "Australia" },
    sameAs: [SITE.url, ...SOCIALS.map((s) => s.href)],
};

const website = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE.url}/#website`,
    name: SITE.name,
    url: SITE.url,
    inLanguage: "en-AU",
    about: { "@id": BUSINESS.orgId },
    publisher: { "@id": BUSINESS.orgId },
};

const jsonLd = [organization, website, ...schema];
---

<!doctype html>
<html lang="en-AU">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {noindex && <meta name="robots" content="noindex, follow" />}
        <meta name="theme-color" content="#f5f6f8" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/images/mark-512.png" />
        <link rel="preload" href="/fonts/Satoshi-Variable.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={SITE.name} />
        <meta property="og:locale" content={SITE.locale} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />

        {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    </head>
    <body>
        <a class="skip sr-only" href="#main">Skip to content</a>
        <Header />
        <main id="main">
            <slot />
        </main>
        <Footer />
    </body>
</html>
