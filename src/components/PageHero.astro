---
import Breadcrumbs from "./Breadcrumbs.astro";
interface Props {
    eyebrow?: string;
    title: string;
    lead?: string;
    crumbs?: { name: string; path: string }[];
}
const { eyebrow, title, lead, crumbs } = Astro.props;
---

<section class="hero">
    <div class="wrap">
        {crumbs && <Breadcrumbs crumbs={crumbs} />}
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1>{title}</h1>
        {lead && <p class="lead">{lead}</p>}
        <slot />
    </div>
</section>

<style>
    .hero {
        padding-block: clamp(40px, 7vw, 84px) clamp(32px, 5vw, 56px);
        background: radial-gradient(70% 90% at 50% -20%, rgb(221 40 40 / 0.16), transparent 70%);
        border-bottom: 1px solid var(--border);
    }
    h1 {
        font-size: clamp(2.2rem, 5vw, 3.6rem);
        max-width: 22ch;
    }
</style>
