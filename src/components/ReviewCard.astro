---
import Stars from "./Stars.astro";
import GoogleMark from "./GoogleMark.astro";
import { GOOGLE_REVIEWS_URL } from "../data/site";
import { SERVICE_LABELS, type Review } from "../data/reviews";

interface Props {
    review: Review;
    /** Render as an anchor target (used on /reviews/). */
    anchor?: boolean;
    showCaseLink?: boolean;
}
const { review, anchor = false, showCaseLink = true } = Astro.props;
/** Split Google's line breaks into paragraphs and lines, so the text reads exactly as it does on Google. */
const paras = (text: string) => text.split(/\n{2,}/).map((p) => p.split("\n"));
const date = review.createTime ? new Date(review.createTime).toLocaleDateString("en-AU", { month: "short", year: "numeric" }) : null;
const initials = review.name
    .split(/[\s,]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((p) => p[0]!.toUpperCase())
    .join("");
---

<article class="card review" id={anchor ? review.id : undefined}>
    <div class="top">
        <Stars rating={review.rating} />
        <a class="src" href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener" aria-label={`${review.name}'s review on Google`}>
            <GoogleMark size={16} /> Google
        </a>
    </div>
    <blockquote>
        {paras(review.text).map((lines) => <p>{lines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>)}
    </blockquote>
    <footer>
        <span class="avatar" aria-hidden="true">{initials}</span>
        <div>
            <cite>{review.name}</cite>
            {review.business && <span class="biz">{review.business}</span>}
        </div>
        {date && <time class="date" datetime={review.createTime!}>{date}</time>}
    </footer>
    {
        review.reply && (
            <details class="reply">
                <summary>Reply from Webb Media</summary>
                {paras(review.reply).map((lines) => <p>{lines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>)}
            </details>
        )
    }
    {
        (review.services.length > 0 || (showCaseLink && review.caseStudy)) && (
            <div class="tags">
                {review.services.map((s) => (
                    <span class="chip">{SERVICE_LABELS[s]}</span>
                ))}
                {showCaseLink && review.caseStudy && (
                    <a class="chip chip-accent" href={`/case-studies/${review.caseStudy}/`}>
                        See the results →
                    </a>
                )}
            </div>
        )
    }
</article>

<style>
    .review {
        display: flex;
        flex-direction: column;
        gap: 14px;
        scroll-margin-top: 90px;
    }
    .review:target {
        border-color: var(--accent);
    }
    .top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .src {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        color: var(--subtle);
        text-decoration: none;
    }
    .src:hover {
        color: var(--text);
    }
    blockquote {
        margin: 0;
    }
    blockquote p {
        margin: 0 0 0.8em;
        color: var(--text-2);
    }
    blockquote p:last-child {
        margin-bottom: 0;
    }
    .date {
        margin-left: auto;
        font-size: 0.8rem;
        color: var(--subtle);
        white-space: nowrap;
    }
    .reply {
        border-left: 2px solid var(--border);
        padding-left: 12px;
        font-size: 0.9rem;
        color: var(--muted);
    }
    .reply summary {
        cursor: pointer;
        font-weight: 600;
        font-size: 0.82rem;
        color: var(--subtle);
    }
    .reply p {
        margin: 8px 0 0;
    }
    footer {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .avatar {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--accent-soft);
        color: var(--accent-text);
        font-weight: 800;
        font-size: 0.85rem;
        flex-shrink: 0;
    }
    cite {
        display: block;
        font-style: normal;
        font-weight: 700;
    }
    .biz {
        display: block;
        font-size: 0.85rem;
        color: var(--muted);
    }
    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }
</style>
