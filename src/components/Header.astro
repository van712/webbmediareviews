---
import { NAV, GOOGLE_REVIEWS_URL } from "../data/site";
const path = Astro.url.pathname;
---

<header class="header">
    <div class="wrap bar">
        <a href="/" class="brand" aria-label="Webb Media Reviews home">
            <img src="/images/logo.svg" width="34" height="34" alt="Webb Media logo" />
            <span>Webb Media <strong>Reviews</strong></span>
        </a>
        <nav aria-label="Main">
            <details class="menu">
                <summary aria-label="Open menu">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
                </summary>
                <ul>
                    {
                        NAV.map((item) => (
                            <li>
                                <a href={item.href} aria-current={path.startsWith(item.href) ? "page" : undefined}>
                                    {item.label}
                                </a>
                            </li>
                        ))
                    }
                    <li class="cta-li">
                        <a class="btn btn-ghost" href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener">Reviews on Google ↗</a>
                    </li>
                </ul>
            </details>
        </nav>
    </div>
</header>

<style>
    .header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgb(var(--bg-rgb) / 0.88);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
    }
    .bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 68px;
        gap: 16px;
    }
    .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        font-size: 1.05rem;
        font-weight: 500;
        white-space: nowrap;
    }
    .brand img {
        border-radius: 8px;
    }
    .brand strong {
        font-weight: 800;
    }
    .menu summary {
        list-style: none;
        cursor: pointer;
        display: none;
        padding: 8px;
        border: 1px solid var(--border);
        border-radius: 10px;
    }
    .menu summary::-webkit-details-marker {
        display: none;
    }
    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        align-items: center;
        gap: 4px;
    }
    li a:not(.btn) {
        display: block;
        padding: 8px 12px;
        border-radius: 8px;
        text-decoration: none;
        color: var(--muted);
        font-weight: 600;
        font-size: 0.95rem;
    }
    li a:not(.btn):hover,
    li a[aria-current="page"] {
        color: var(--text);
    }
    .cta-li {
        margin-left: 8px;
    }
    .cta-li .btn {
        min-height: 42px;
        padding: 8px 18px;
        font-size: 0.92rem;
    }

    /* Desktop: the <details> is always open and the toggle is hidden. */
    @media (min-width: 960px) {
        .menu > ul {
            display: flex !important;
        }
    }
    @media (max-width: 959px) {
        .menu summary {
            display: block;
        }
        .menu:not([open]) > ul {
            display: none;
        }
        .menu[open] > ul {
            position: absolute;
            left: 0;
            right: 0;
            top: 68px;
            flex-direction: column;
            align-items: stretch;
            padding: 12px 16px 20px;
            background: var(--bg);
            border-bottom: 1px solid var(--border);
        }
        .cta-li {
            margin: 8px 0 0;
        }
        .cta-li .btn {
            width: 100%;
            min-height: 48px;
        }
    }
</style>

<script>
    // On desktop the nav is always visible: keep <details> open so links are reachable without JS on mobile.
    const menu = document.querySelector<HTMLDetailsElement>(".menu");
    const mq = window.matchMedia("(min-width: 960px)");
    const sync = () => menu && (menu.open = mq.matches);
    sync();
    mq.addEventListener("change", sync);
</script>
