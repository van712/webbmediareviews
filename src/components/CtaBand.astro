---
import { BOOK_CALL_URL } from "../data/site";
interface Props {
    title?: string;
    body?: string;
}
const {
    title = "Want results like these?",
    body = "Book a free 15 minute call with Van. No sales team, no pressure. He'll look at your business and tell you straight if Webb Media can help.",
} = Astro.props;
---

<section class="section">
    <div class="wrap">
        <div class="band">
            <div>
                <h2>{title}</h2>
                <p class="lead">{body}</p>
            </div>
            <div class="btn-row">
                <a class="btn btn-primary" href={BOOK_CALL_URL}>Book a free call</a>
                <a class="btn btn-ghost" href="/reviews/">Read more reviews</a>
            </div>
        </div>
    </div>
</section>

<style>
    .band {
        display: grid;
        gap: 24px;
        align-items: center;
        grid-template-columns: 1.6fr auto;
        padding: clamp(28px, 5vw, 56px);
        border-radius: 24px;
        border: 1px solid rgb(221 40 40 / 0.35);
        background:
            radial-gradient(120% 140% at 0% 0%, rgb(221 40 40 / 0.22), transparent 60%),
            var(--surface);
    }
    .band h2 {
        margin-bottom: 0.3em;
    }
    .band .lead {
        margin: 0;
    }
    @media (max-width: 800px) {
        .band {
            grid-template-columns: 1fr;
        }
    }
</style>
