---
/**
 * Closing band on every page. Deliberately not a sales pitch: it points
 * readers to the original sources so they can verify everything themselves.
 */
import { BUSINESS, GOOGLE_REVIEWS_URL } from "../data/site";
interface Props {
    title?: string;
    body?: string;
}
const {
    title = "Don't just take this page's word for it",
    body = "Every review here is public. Read them on Google, check the ABN on the Australian Business Register, or look at the live websites in the case studies.",
} = Astro.props;
---

<section class="section">
    <div class="wrap">
        <div class="band">
            <div>
                <h2>{title}</h2>
                <p class="lead">{body}</p>
            </div>
            <div class="btn-row">
                <a class="btn btn-primary" href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener">Read the reviews on Google</a>
                <a class="btn btn-ghost" href={BUSINESS.mainSite}>Visit webbmedia.com.au</a>
            </div>
        </div>
    </div>
</section>

<style>
    .band {
        display: grid;
        gap: 24px;
        align-items: center;
        grid-template-columns: 1.6fr auto;
        padding: clamp(28px, 5vw, 56px);
        border-radius: 24px;
        border: 1px solid var(--border);
        background:
            radial-gradient(120% 140% at 0% 0%, rgb(var(--accent-rgb) / 0.14), transparent 60%),
            var(--surface);
    }
    .band h2 {
        margin-bottom: 0.3em;
    }
    .band .lead {
        margin: 0;
    }
    @media (max-width: 800px) {
        .band {
            grid-template-columns: 1fr;
        }
    }
</style>
